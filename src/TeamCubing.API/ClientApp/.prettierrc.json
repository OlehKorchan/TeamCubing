{
  "trailingComma": "all",
  "tabWidth": 2,
  "semi": true,
  "singleQuote": true,
  "bracketSpacing": true,
  "printWidth": 100,
  "endOfLine": "crlf",
  "overrides": [
    {
      "files": "*.html",
      "options": {
        "parser":"html",
        "singleQuote": false
      }
    },
    {
      "files": "*.component.html",
      "options": {
        "parser":"angular"
      }
    }
  ]
}
